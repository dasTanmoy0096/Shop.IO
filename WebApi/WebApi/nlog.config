<?xml version="1.0" encoding="utf-8" ?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   throwConfigExceptions="true"
   autoReload="true">

  <!-- =========================================================
       MICROSOFT SIMPLECONSOLEFORMATTER LEVEL NAMES

       Trace       -> trce
       Debug       -> dbug
       Information -> info
       Warning     -> warn
       Error       -> fail
       Critical    -> crit
       ========================================================= -->

  <variable name="msLevel"
            value="${when:when=level == LogLevel.Trace:inner=trce}${when:when=level == LogLevel.Debug:inner=dbug}${when:when=level == LogLevel.Info:inner=info}${when:when=level == LogLevel.Warn:inner=warn}${when:when=level == LogLevel.Error:inner=fail}${when:when=level == LogLevel.Fatal:inner=crit}" />

  <targets>

    <!-- =========================================================
        ASYNCHRONOUS-FIRST LOGGING

        Normal operation:
            producer -> bounded queue -> background writer

        Queue full:
            block instead of silently discarding log events.
        ========================================================= -->

    <default-wrapper xsi:type="AsyncWrapper"
                    overflowAction="Block"
                    queueLimit="10000"
                    batchSize="200"
                    timeToSleepBetweenBatches="0" />


    <!-- =========================================================
        APPLICATION / FRAMEWORK LOGGING
        Console -> stdout only
        ========================================================= -->

    <target xsi:type="ColoredConsole"
            name="appConsole"
            stdErr="false"
            autoFlush="true"
            enableAnsiOutput="true"
            noColor="false"
            detectOutputRedirected="true"
            useDefaultRowHighlightingRules="false"
            layout="${date:universalTime=true:format=yyyy-MM-dd HH\:mm\:ss.fff} - ${var:msLevel}: ${logger}[${event-properties:item=EventId:whenEmpty=0}] - ${replace-newlines:${message}}${onexception:inner= - ${replace-newlines:${exception:format=tostring}}}">


      <!-- Trace: Gray on Black -->
      <highlight-word text=" - trce: "
                      wholeWords="true"
                      condition="level == LogLevel.Trace"
                      foregroundColor="Gray"
                      backgroundColor="Black" />


      <!-- Debug: Gray on Black -->
      <highlight-word text=" - dbug: "
                      wholeWords="true"
                      condition="level == LogLevel.Debug"
                      foregroundColor="Gray"
                      backgroundColor="Black" />


      <!-- Information: DarkGreen on Black -->
      <highlight-word text=" - info: "
                      wholeWords="true"
                      condition="level == LogLevel.Info"
                      foregroundColor="DarkGreen"
                      backgroundColor="Black" />


      <!-- Warning: Yellow on Black -->
      <highlight-word text=" - warn: "
                      wholeWords="true"
                      condition="level == LogLevel.Warn"
                      foregroundColor="Yellow"
                      backgroundColor="Black" />


      <!-- Error: Black on DarkRed -->
      <highlight-word text=" - fail: "
                      wholeWords="true"
                      condition="level == LogLevel.Error"
                      foregroundColor="Black"
                      backgroundColor="DarkRed" />


      <!-- Critical: White on DarkRed -->
      <highlight-word text=" - crit: "
                      wholeWords="true"
                      condition="level == LogLevel.Fatal"
                      foregroundColor="White"
                      backgroundColor="DarkRed" />

    </target>



    <!-- =========================================================
        HTTP ACCESS LOGGING
        Console -> stdout only

        W3C Extended Log entry records.

        The CompoundLayout deliberately prevents the nested
        W3CExtendedLogLayout's header from reaching the Console
        target.

        Therefore:
            NO #Version
            NO #Fields
            NO #Software
            NO #Start-Date
            NO leading blank header line
        ========================================================= -->

    <target xsi:type="Console"
            name="accessConsole"
            stdErr="false"
            autoFlush="true"
            forceWriteLine="true">

      <layout xsi:type="CompoundLayout">

        <layout xsi:type="W3CExtendedLogLayout">


          <!-- ===================================================
              TRANSACTION
              =================================================== -->

          <!-- Transaction completion date, UTC/GMT -->
          <field name="date"
                layout="${date:universalTime=true:format=yyyy-MM-dd}" />


          <!-- Transaction completion time, UTC/GMT -->
          <field name="time"
                layout="${date:universalTime=true:format=HH\:mm\:ss.fff}" />



          <!-- ===================================================
              CLIENT / SERVER ADDRESS INFORMATION
              =================================================== -->

          <!-- Client IP address -->
          <field name="c-ip"
                layout="${aspnet-request-ip}" />


          <!-- Server/local IP address -->
          <field name="s-ip"
                layout="${aspnet-request-local-ip}" />



          <!-- ===================================================
              HTTP REQUEST
              =================================================== -->

          <!-- HTTP request method -->
          <field name="cs-method"
                layout="${event-properties:item=Method}" />


          <!-- Complete request URI -->
          <field name="cs-uri"
                layout="${event-properties:item=Scheme}://${event-properties:item=Host}${event-properties:item=PathBase}${event-properties:item=Path}${event-properties:item=QueryString}" />


          <!-- URI without query component -->
          <field name="cs-uri-stem"
                layout="${event-properties:item=PathBase}${event-properties:item=Path}" />


          <!-- Query component without leading '?' -->
          <field name="cs-uri-query"
                layout="${substring:inner=${event-properties:item=QueryString}:start=1}" />



          <!-- ===================================================
              HTTP RESPONSE
              =================================================== -->

          <!-- HTTP response status -->
          <field name="sc-status"
                layout="${event-properties:item=StatusCode}" />



          <!-- ===================================================
              CLIENT -> SERVER HTTP HEADERS
              =================================================== -->

          <!-- Host -->
          <field name="cs(Host)"
                layout="${event-properties:item=Host}" />


          <!-- User-Agent -->
          <field name="cs(User-Agent)"
                layout="${aspnet-request-useragent}" />


          <!-- Referring URI -->
          <field name="cs(Referer)"
                layout="${aspnet-request-referrer}" />


          <!-- Request Content-Type -->
          <field name="cs(Content-Type)"
                layout="${aspnet-request-contenttype}" />


          <!-- Request Content-Length -->
          <field name="cs(Content-Length)"
                layout="${aspnet-request-contentlength}" />



          <!-- ===================================================
              SERVER -> CLIENT HTTP HEADERS
              =================================================== -->

          <!-- Response Content-Type -->
          <field name="sc(Content-Type)"
                layout="${event-properties:item=ContentType}" />


          <!-- Response Content-Length -->
          <field name="sc(Content-Length)"
                layout="${event-properties:item=ContentLength}" />


          <!-- Redirect Location, when applicable -->
          <field name="sc(Location)"
                layout="${aspnet-response-headers:Items=Location:ValuesOnly=true}" />



          <!-- ===================================================
              W3C x-* APPLICATION-SPECIFIC EXTENSIONS
              ===================================================

              The W3C Working Draft explicitly defines prefix "x"
              for application-specific identifiers.
              =================================================== -->


          <!-- http / https -->
          <field name="x-scheme"
                layout="${event-properties:item=Scheme}" />


          <!-- HTTP/1.1 / HTTP/2 / HTTP/3 etc. -->
          <field name="x-protocol"
                layout="${event-properties:item=Protocol}" />


          <!-- Server-side TCP listening port -->
          <field name="x-server-port"
                layout="${aspnet-request-local-port}" />


          <!-- Client-side TCP source port -->
          <field name="x-client-port"
                layout="${aspnet-request-remote-port}" />


          <!-- Server machine name -->
          <field name="x-server-name"
                layout="${machinename}" />


          <!-- Authenticated ASP.NET Core identity, when present -->
          <field name="x-user-identity"
                layout="${aspnet-user-identity}" />


          <!--
              ASP.NET Core endpoint metadata.

              This is endpoint metadata rather than the concrete URI,
              so it can describe the matched route/endpoint when one
              has been assigned.
          -->
          <field name="x-endpoint-name"
                layout="${aspnet-request-endpoint-name}" />


          <!--
              ASP.NET Core RequestFinished supplies
              ElapsedMilliseconds.

              Deliberately NOT called "time-taken", because the W3C
              Working Draft defines time-taken in SECONDS.
          -->
          <field name="x-duration-ms"
                layout="${event-properties:item=ElapsedMilliseconds}" />

        </layout>

      </layout>

    </target>

  </targets>



  <rules>

    <!-- =========================================================
        ACCESS-LOG ROUTING

        ASP.NET Core:

          Category:
            Microsoft.AspNetCore.Hosting.Diagnostics

          EventId:
            2

          Meaning:
            RequestFinished

          Level:
            Information

        Only the completed-request event is sent to accessConsole.
        ========================================================= -->

    <logger name="Microsoft.AspNetCore.Hosting.Diagnostics"
            minLevel="Info"
            writeTo="accessConsole">

      <filters defaultAction="Ignore">

        <when condition="'${event-properties:item=EventId}' == '2'"
              action="Log" />

      </filters>

    </logger>



    <!-- =========================================================
        ASP.NET CORE DEFAULT TEMPLATE FILTERING

        Equivalent to:

          "Microsoft.AspNetCore": "Warning"

        RequestFinished Information events required for the access
        target are captured by the rule above before these rules
        prevent ASP.NET Core Information noise from reaching the
        ordinary application target.
        ========================================================= -->

    <logger name="Microsoft.AspNetCore"
            finalMinLevel="Warn" />

    <logger name="Microsoft.AspNetCore.*"
            finalMinLevel="Warn" />



    <!-- =========================================================
        DEFAULT = Information
        ========================================================= -->

    <logger name="*"
            minLevel="Info"
            writeTo="appConsole" />

  </rules>

</nlog>
