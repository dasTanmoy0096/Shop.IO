{
  "AllowedHosts": "api.shopio.example.invalid",
  "Cors": {
    "AllowedOrigins": [
      "https://www.shopio.example.invalid"
    ],
    "AllowCredentials": true,
    "AllowedMethods": [
      "GET",
      "POST",
      "PATCH",
      "DELETE"
    ],
    "AllowedHeaders": [
      "Accept",
      "Content-Type",
      "If-Match",
      "Origin",
      "X-ShopIO-Antiforgery"
    ],
    "ExposedHeaders": [
      "Retry-After"
    ],
    "PreflightMaxAgeSeconds": 600
  },
  "DataAccess": {
    "Accounts": {
      "UsernameMinimumLength": 3,
      "UsernameMaximumLength": 64,
      "PasswordMinimumLength": 15,
      "PasswordMaximumLength": 128,
      "PasswordHashIterationCount": 220000,
      "PasswordBlocklist": [
        "123456789012345",
        "passwordpassword",
        "password123456789",
        "qwertyuiopasdfgh",
        "letmeinletmein",
        "welcome123456789",
        "shopioshopioshop",
        "shop.io shop.io"
      ]
    },
    "MariaDb": {
      "DataSourceName": "Shop.IO Web API",
      "Server": "mariadb.shopio.example.invalid",
      "Port": 3306,
      "UserID": "shopio_runtime",
      "Database": "shop_io",
      "LoadBalance": "RoundRobin",
      "ConnectionProtocol": "Socket",
      "SslMode": "VerifyFull",
      "CertificateFile": "",
      "CertificateStoreLocation": "None",
      "CertificateThumbprint": "",
      "SslCert": "",
      "SslKey": "",
      "SslCa": "",
      "SkipCertificateRevocationCheck": false,
      "TlsVersion": "",
      "TlsCipherSuites": "",
      "Pooling": true,
      "ConnectionLifeTime": 0,
      "ConnectionReset": true,
      "ConnectionIdleTimeout": 180,
      "MinimumPoolSize": 0,
      "MaximumPoolSize": 100,
      "DnsCheckInterval": 0,
      "AllowLoadLocalInfile": false,
      "AllowPublicKeyRetrieval": false,
      "AllowUserVariables": false,
      "AllowZeroDateTime": false,
      "AutoEnlist": false,
      "CancellationTimeout": 2,
      "ConnectionTimeout": 15,
      "ConvertZeroDateTime": false,
      "DateTimeKind": "Utc",
      "DefaultCommandTimeout": 30,
      "GuidFormat": "Char36",
      "IgnoreCommandTransaction": false,
      "InteractiveSession": false,
      "KeepAlive": 0,
      "NoBackslashEscapes": false,
      "PersistSecurityInfo": false,
      "Pipelining": true,
      "ServerRedirectionMode": "Disabled",
      "ServerRsaPublicKeyFile": "",
      "ServerSPN": "",
      "TreatTinyAsBoolean": true,
      "UseAffectedRows": true,
      "UseCompression": false,
      "UseXaTransactions": false
    }
  },
  "Security": {
    "Authentication": {
      "CookieName": "__Host-ShopIO.Api.Auth",
      "CookiePath": "/",
      "CookieDomain": "",
      "CookieHttpOnly": true,
      "CookieSameSite": "Strict",
      "CookieSecurePolicy": "Always",
      "CookieIsEssential": true,
      "CookieLifetimeMinutes": 480,
      "CookiePersistent": false,
      "SlidingExpiration": false
    },
    "DataProtection": {
      "ApplicationName": "Shop.IO Web API",
      "KeyDirectory": "",
      "KeyLifetimeDays": 90,
      "CertificateFile": ""
    },
    "Antiforgery": {
      "CookieName": "__Host-ShopIO.Api.Antiforgery",
      "CookiePath": "/",
      "CookieDomain": "",
      "CookieHttpOnly": true,
      "CookieSameSite": "Strict",
      "CookieSecurePolicy": "Always",
      "CookieIsEssential": true,
      "HeaderName": "X-ShopIO-Antiforgery",
      "FormFieldName": "__ShopIOAntiforgery",
      "SuppressReadingTokenFromFormBody": true,
      "SuppressXFrameOptionsHeader": false
    },
    "RateLimiting": {
      "RejectionStatusCode": 429,
      "RejectionMessage": "Too many requests. Please try again later.",
      "AntiforgeryToken": {
        "PermitLimit": 30,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst",
        "AutoReplenishment": true
      },
      "SignIn": {
        "PermitLimit": 5,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst",
        "AutoReplenishment": true
      },
      "Registration": {
        "PermitLimit": 3,
        "WindowSeconds": 600,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst",
        "AutoReplenishment": true
      },
      "Search": {
        "PermitLimit": 60,
        "WindowSeconds": 60,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst",
        "AutoReplenishment": true
      },
      "Payment": {
        "PermitLimit": 5,
        "WindowSeconds": 300,
        "SegmentsPerWindow": 6,
        "QueueLimit": 0,
        "QueueProcessingOrder": "OldestFirst",
        "AutoReplenishment": true
      }
    },
    "EnableHsts": true,
    "EnableHttpsRedirection": true
  }
}
