{
  "devDependencies": {
    "jspm": "^4.6.1",
    "typescript": "^7.0.2"
  },
  "name": "wwwroot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "tsc --project tsconfig.json",
    "watch": "tsc --project tsconfig.json --watch --preserveWatchOutput",
    "generate:importmap": "npm run build && jspm install --map importmap.json --out importmap.json && jspm install --map importmap.json --out importmap.js --integrity"
  },
  "exports": {
    ".": "./scripts/pages/index.js"
  }
}
